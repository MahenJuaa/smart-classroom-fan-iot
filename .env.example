# Supabase Dashboard > Connect > Session pooler (for persistent hosted backend)
# Keep this database connection string ONLY on the backend host.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres

# Generate both values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DEVICE_TOKEN=REPLACE_WITH_SEPARATE_RANDOM_DEVICE_TOKEN_AT_LEAST_32_CHARACTERS

ADMIN_USERNAME=admin
ADMIN_PASSWORD=SET_A_STRONG_UNIQUE_PASSWORD
COOKIE_SECURE=true
DEVICE_ONLINE_SECONDS=20
PORT=5000
