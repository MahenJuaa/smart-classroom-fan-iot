# Vercel + Supabase: use the Supabase Transaction Pooler (port 6543).
# Never commit real credentials. Set these values in Vercel Project Settings > Environment Variables.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:6543/postgres

# Generate separate random values (at least 32 characters).
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DEVICE_TOKEN=REPLACE_WITH_SEPARATE_RANDOM_DEVICE_TOKEN_AT_LEAST_32_CHARACTERS

ADMIN_USERNAME=admin
ADMIN_PASSWORD=SET_A_STRONG_UNIQUE_PASSWORD
COOKIE_SECURE=true
DEVICE_ONLINE_SECONDS=30
